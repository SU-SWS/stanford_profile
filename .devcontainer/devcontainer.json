{
  name: "CardinalSites",
  dockerComposeFile: "docker-compose.yml",
  service: "web",
  forwardPorts: [80],
  portsAttributes: {
    '80': {
      label: "Web"
    }
  },
  postStartCommand: "${containerWorkspaceFolder}/.devcontainer/setup.sh ${containerWorkspaceFolder}",
  customizations: {
    vscode: {
      settings: {
        "breadcrumbs.enabled": true,
        "css.validate": true,
        "diffEditor.ignoreTrimWhitespace": false,
        "editor.tabSize": 2,
        "editor.autoIndent": "full",
        "editor.insertSpaces": true,
        "editor.formatOnPaste": true,
        "editor.formatOnSave": false,
        "editor.renderWhitespace": "boundary",
        "editor.wordWrapColumn": 80,
        "editor.wordWrap": "off",
        "editor.detectIndentation": true,
        "editor.rulers": [
          80
        ],
        "files.associations": {
          "*.inc": "php",
          "*.module": "php",
          "*.install": "php",
          "*.theme": "php",
          "*.profile": "php",
          "*.test": "php",
          "*.php": "php",
          "*.info": "ini"
        },
        "files.trimTrailingWhitespace": true,
        "files.restoreUndoStack": false,
        "files.insertFinalNewline": true,
        "html.format.enable": true,
        "html.format.wrapLineLength": 80,
        "telemetry.telemetryLevel": "off",

        /* PHP Intelephense (bmewburn.vscode-intelephense-client) */
        "intelephense.environment.includePaths": [
          "core/",
          "core/includes",
          "../vendor/"
        ]
      },
      extensions: {
        "recommendations": [
          "bmewburn.vscode-intelephense-client",
          "dbaeumer.vscode-eslint",
          "duboiss.sf-pack",
          "eduardgenzora.symfony-service-locator",
          "formulahendry.vscode-mysql",
          "george-alisson.html-preview-vscode",
          "ikappas.composer",
          "marcostazi.vs-code-drupal",
          "mblode.twig-language-2",
          "mehedidracula.php-namespace-resolver",
          "mohd-akram.vscode-html-format",
          "mrmlnc.vscode-apache",
          "nadim-vscode.symfony-code-snippets",
          "nadim-vscode.twig-code-snippets",
          "phproberto.vscode-php-getters-setters",
          "redhat.vscode-yaml",
          "stanislav.vscode-drupal",
          "thenouillet.symfony-vscode",
        ]
      }
    }
  }
}
