{% set headline %}
  <a href="{{ url }}">{{ label|render_clean }}</a>
{% endset %}
<div{{ attributes }}>
  {{ include("jumpstart_ui:card", {
    header_tag: "h2",
    image: content.su_opp_image,
    super_headline: node.su_opp_sponsor.value,
    headline: headline,
    body: [
      content.su_opp_type,
      content.su_opp_summary,
    ],

  }, with_context = false) }}
</div>
