{% set headline %}
  <a href="{{ url }}">{{ node.label }}</a>
{% endset %}
<div{{ attributes }}>
  {{ title_prefix }}
  {{ include("jumpstart_ui:card", {
    header_tag: "h3",
    headline: headline,
    body: node.su_event_series_subheadline.value
  }, with_context = false) }}
  {{ title_suffix }}
</div>
