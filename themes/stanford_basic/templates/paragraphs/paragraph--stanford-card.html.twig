<div{{ attributes }}>
  {{ include("jumpstart_ui:card", {
    image: content["su_card_media"],
    headline: content["su_card_header"],
    body: [
      content["su_card_super_header"],
      content["su_card_body"],
    ],
    link: content["su_card_link"][0]["#url_title"],
    button_label: component["link_style"] != "action" ? content["su_card_link"][0]['#title'] : null,
    cta_label: component["link_style"] == "action" ? content["su_card_link"][0]['#title'] : null,
  }|merge(component), with_context = false) }}
</div>

