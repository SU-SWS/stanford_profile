{% set heading %}
  <h3>
    <a href="{{ node.su_media_source.get(0).getUrl().toString() ?: url }}">{{ node.label }}</a>
  </h3>
{% endset %}
<div{{ attributes }}>
  {{ title_prefix }}
  {{ include("jumpstart_ui:container_responsive_card", {
    header_tag: "h3",
    image: content.su_media_image,
    heading: heading,
    body: [
      content.su_media_date,
      content.su_media_dek,
      content.su_media_series,
      content.su_media_category,
    ]
  }, with_context = false) }}
  {{ title_suffix }}
</div>
