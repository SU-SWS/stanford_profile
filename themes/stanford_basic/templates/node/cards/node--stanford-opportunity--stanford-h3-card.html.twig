{% set headline %}
  <a href="{{ url }}">{{ label|render_clean }}</a>
{% endset %}
<div{{ attributes }}>
  {{ include("jumpstart_ui:card", {
    header_tag: "h3",
    image: content["su_opp_image"],
    super_headline: content["su_opp_sponsor"],
    headline: headline,
    body: [
      content["su_opp_summary"],
      content["su_opp_card_footer"],
      content["su_opp_icon"],
    ],

  }, with_context = false) }}
</div>
