
<div{{ attributes }}>
  {{ title_prefix }}
  {{ include("jumpstart_ui:card", {
    header_tag: "h3",
    plain: true,
    image: content.su_person_photo,
    headline: node.label,
    headline_url: node.su_person_source.get(0).getUrl().toString() ?: url,
    body: node.su_person_short_title.value
  }, with_context = false) }}
  {{ title_suffix }}
</div>
