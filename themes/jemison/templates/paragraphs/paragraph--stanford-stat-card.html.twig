
{% set heading_behavior = paragraph.su_stat_headline_lvl.value|default("h2")|split(".") %}

<div{{ attributes }}>
  {{ title_prefix }}
  {{ include("jemison:paragraph_stat_card", {
    header_tag: heading_behavior.0,
    header_classes: heading_behavior|slice(1)|join(" "),
    visually_hide_header: paragraph.su_stat_heading_hide.value,
    bg_color: paragraph.su_stat_bg_color.color,
    icon_color: paragraph.su_stat_icon_color.color,
    stat_color: paragraph.su_stat_stat_color.color,
    centered_text: paragraph.su_stat_centered.value,
    image: content.su_stat_image,
    icon: content.su_stat_icon,
    stat: paragraph.su_stat_stat.value,
    super_headline: paragraph.su_stat_superhead.value,
    headline: paragraph.su_stat_headline.value,
    body: content.su_stat_body,
    link: content.su_stat_button,
  }, with_context = false) }}
  {{ title_suffix }}
</div>
