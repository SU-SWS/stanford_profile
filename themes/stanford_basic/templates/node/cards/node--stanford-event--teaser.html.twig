{% set date_time = node.su_event_date_time.get(0).value %}
<div{{ attributes }}>
  {{ include("jumpstart_ui:event_list", {
    header_tag: "h3",
    start_month: date_time|date("M"),
    start_date: date_time|date("j"),
    end_month: date_time|date("M"),
    end_date: date_time|date("j"),
    event_type: content.su_event_type,
    headline: node.label,
    subheadline: node.su_event_subheadline.value,
    dek: node.su_event_dek.value,
    url: node.su_event_source.get(0).getUrl().toString() ?? url,
    date_time: content.su_event_date_time,
    location: node.su_event_alt_loc.value,
    address: content.su_event_location
  }, with_context = false) }}
</div>
