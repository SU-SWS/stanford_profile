<div{{ attributes }}>
  <button class="accordion--title">
    {% if heading_level %}
      <{{ heading_tag }}>{{ question }}</{{ heading_tag }}>
    {% else %}
      {{ question }}
    {% endif %}
  </button>
  {% block answer %}
    <div class="accordion--contents">
      {{ answer }}
    </div>
  {% endblock %}
</div>
