
{% for level, messages in message_list %}
  {% if level == "status" %}
    {% set level = "info" %}
  {% endif %}

  {# Good for everyone. #}
  {% if status_headings[type] %}
    <h2 class="visually-hidden">{{ status_headings[type] }}</h2>
  {% endif %}

  {% for message in messages %}
    {{ include("jumpstart_ui:alert", {
      level: level,
      message: message
    }, with_context = false) }}
  {% endfor %}
{% endfor %}
