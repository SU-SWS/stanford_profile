
{% if node.su_policy_updated|length %}
  {% set dek = "Last Updated " ~ node.su_policy_updated.value|date("F j, Y") %}
{% endif %}
<div{{ attributes }}>
  {{ title_prefix }}
  {{ include("jumpstart_ui:news_list", {
    header_tag: "h2",
    headline: node.label,
    url: node.su_policy_source.get(0).getUrl().toString() ?: url,
    dek: dek,
    footer: content.body
  }, with_context = false) }}
  {{ title_suffix }}
</div>
