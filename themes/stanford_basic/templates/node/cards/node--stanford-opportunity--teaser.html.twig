{% set headline %}
  <a href="{{ url }}" class="su-opp-title-list">{{ label|render_clean }}</a>
{% endset %}
<div{{ attributes }}>
  {{ include("jumpstart_ui:news_list", {
    image: content.su_opp_image,
    super_headline: content.su_opp_sponsor,
    headline: headline,
    dek: node.su_opp_summary.processed,
    topics: content.su_opp_type,
    footer: node.su_opp_card_footer.value
  }, with_context = false) }}
</div>
