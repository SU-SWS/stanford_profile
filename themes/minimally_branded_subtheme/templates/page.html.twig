{#
/**
 * Page.html.twig from stanford_basic.
 */
#}
{%- extends "@stanford_basic/page.html.twig" -%}

{%- block block_brandbar -%}
  <div class="su-brand-bar su-brand-bar--dark"></div>
{% endblock %}

{# Override the footer #}
{% block block_footer %}
  <footer id="footer">
    {{ page.footer }}

    {% if external_link_text is empty -%}
      {%- set external_link_text -%}
        <span class="su-global-footer__link-a11y">(link is external)</span>
      {% endset %}
    {%- endif %}

    <div class="su-global-footer su-global-footer--dark">
      {{ include('jumpstart_ui:global_footer', {}, with_context = false) }}
    </div>

  </footer>
{% endblock %}
