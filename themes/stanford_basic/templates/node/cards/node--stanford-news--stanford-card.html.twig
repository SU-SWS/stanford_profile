<div{{ attributes }}>
  {{ include("jumpstart_ui:news_vertical_teaser", {
    header_tag: "h2",
    image: content.su_news_featured_media,
    headline: label,
    date: content.su_news_publishing_date,
    dek: [
      content.su_news_dek,
      content.su_news_quote
    ],
    topics: [
      content.su_news_topics,
      content.su_news_spotlight_filters
    ],
    source: node.su_news_source.get(0).getUrl().toString(),
    url: url,
  }, with_context = false) }}
</div>

